# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (service_role / secret key) — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Stripe (server only). Prefer a restricted key (rk_…) with Checkout Sessions: write.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Optional: payment method configuration (pmc_…) with only PromptPay enabled
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Base URL for Checkout success/cancel redirects
APP_URL=http://localhost:3000

# Cloudflare R2 (server only). API token: Object Read & Write, scoped to both buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket: episode pages (signed URLs only)
R2_BUCKET=toon-universe-pages
# Public bucket: covers (r2.dev subdomain in dev, custom domain in production)
R2_PUBLIC_BUCKET=toon-universe-public
NEXT_PUBLIC_R2_PUBLIC_URL=
